\author{\texorpdfstring{alg-d\\ \url{https://alg-d.com/math/kan_extension/}}{alg-d}}

\pagestyle{plain} % ヘッダー無し、フッターにページ番号
%\theoremstyle{definition}

%\def\labelenumi{$(\theenumi )$}
%\def\theenumi{\arabic{enumi}}

\theoremstyle{titlegothicwithnote}
\newtheorem{theoremnote}[equation]{定理}
\newtheorem{propnote}[equation]{命題}

\theoremstyle{titlegothic}
\newtheorem*{defi}{定義}
\newtheorem{thm}[equation]{定理}
\newtheorem{prop}[equation]{命題}
\newtheorem{lem}[equation]{補題}
\newtheorem{cor}[equation]{系}
\newtheorem{ex}[equation]{例}

% proof環境再定義
\renewcommand{\proofname}{\textgt{証明}}
\renewenvironment{proof}[1][\proofname]{\par
  \pushQED{\qed}%
  \normalfont \topsep6\p@\@plus6\p@\relax
  \trivlist
  \item[\hskip\labelsep #1\@addpunct{\textbf{.}}]\ignorespaces
}{%
  \popQED\endtrivlist\@endpefalse
}

